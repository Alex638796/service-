# ─── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (get it from @userinfobot)
OWNER_ID=123456789

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── Optional (have defaults) ─────────────────────────────────────────────────

# MongoDB database name (default: tgforwardbot)
MONGO_DB_NAME=tgforwardbot

# Delay between forwarded messages in seconds (default: 3.0, minimum: 1.0)
DEFAULT_DELAY_SECONDS=3.0
